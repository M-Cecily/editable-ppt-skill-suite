{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable PPT revision plan",
  "type": "object",
  "required": ["plan_id", "target_deck", "sources", "suggestions"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "target_deck": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suggestion_id", "slide_no", "object_id", "priority", "change_type", "evidence_status", "recommended_action", "rationale", "confidence"],
        "properties": {
          "suggestion_id": {"type": "string", "minLength": 1},
          "slide_no": {"type": "integer", "minimum": 1},
          "object_id": {"type": "string", "minLength": 1},
          "priority": {"enum": ["critical", "high", "medium", "optional"]},
          "change_type": {"enum": ["factual_correction", "evidence_boundary", "terminology", "data_correction", "narrative_restructure", "visual_encoding", "deletion", "addition", "simplification", "citation_or_source_note"]},
          "evidence_status": {"enum": ["supported", "partially_supported", "unsupported", "conflicting", "outdated", "unverifiable_from_uploaded_sources", "not_applicable"]},
          "original_claim": {"type": "string"},
          "recommended_action": {"type": "string", "minLength": 1},
          "recommended_text": {"type": "string"},
          "source_locators": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}

